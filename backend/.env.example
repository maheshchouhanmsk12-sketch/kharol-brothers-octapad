# ========================================================
# KHAROL BROTHERS OCTAPAD - PRODUCTION ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in production secrets.
# NEVER commit .env to GitHub or any public repository.
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Authentication Secret
JWT_SECRET=replace_with_a_secure_random_production_secret

# Production CORS Allowed Origins (Comma-separated, no trailing slash)
# Add your production frontend URLs here:
CORS_ORIGIN=https://kharoloctapad.com,https://www.kharoloctapad.com

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Database -> Connect -> Connect your application (Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kharol_octapad?retryWrites=true&w=majority

